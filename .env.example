# Required: do not commit the real .env
JOBPILOT_ADMIN_EMAIL=you@example.com
JOBPILOT_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_MIN_12_CHARS
JOBPILOT_SESSION_SECRET=REPLACE_WITH_RANDOM_STRING_MIN_32_CHARS
# True behind HTTPS; false ONLY on plain-http localhost
COOKIE_SECURE=true
SYNC_INTERVAL_SECONDS=1800

# Optional additional job boards (public job posting APIs)
# Example: greenhouse board slug or Lever site name, comma-separated
GREENHOUSE_BOARDS=
LEVER_SITES=

# Optional Polish job listings via official Adzuna API
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=pl
ADZUNA_QUERY=Python

# Optional notifications for new high-score matches
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
